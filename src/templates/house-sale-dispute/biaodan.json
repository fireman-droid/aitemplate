{
  "template_config": {
    "template_name": "房屋买卖合同纠纷民事起诉状",
    "root_sections": [
      {
        "id": "section_parties",
        "title": "一、当事人信息",
        "description": "填写原告、被告及第三人的基本身份信息",
        "groups": [
          {
            "id": "group_plaintiff",
            "title": "1. 原告信息",
            "ui_mode": "dynamic_list",
            "allow_add": true,
            "fields_mapping": {
              "type_selector": {
                "label": "主体类型",
                "options": [
                  {
                    "label": "自然人",
                    "value": "natural",
                    "fields": [
                      "p_name", "p_gender_m", "p_gender_f", "p_birth_y", "p_birth_m", "p_birth_d", 
                      "p_ethnic", "p_company", "p_position", "p_phone", "p_reg_addr", "p_res_addr", 
                      "p_id_type", "p_id_num"
                    ]
                  },
                  {
                    "label": "法人/非法人组织",
                    "value": "legal",
                    "fields": [
                      "pc_name", "pc_addr", "pc_reg_addr", "pc_legal_rep", "pc_position", "pc_phone", "pc_credit_code"
                    ],
                    "sub_groups": [
                      {
                        "label": "单位类型 (单选)",
                        "ui_mode": "radio_group_boolean",
                        "fields": [
                          "pc_type_llc", "pc_type_jsc", "pc_type_listed", "pc_type_other_ent", 
                          "pc_type_inst", "pc_type_org", "pc_type_fund", "pc_type_service", 
                          "pc_type_gov", "pc_type_rural", "pc_type_coop", "pc_type_community", 
                          "pc_type_sole", "pc_type_partner", "pc_type_prof"
                        ]
                      },
                      {
                        "label": "所有制性质 (单选)",
                        "ui_mode": "radio_group_boolean",
                        "fields": [
                          "pc_own_state", "pc_own_state_ctrl", "pc_own_state_share", "pc_own_private", "pc_own_other"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "id": "group_agent",
            "title": "2. 委托诉讼代理人",
            "ui_mode": "conditional_section",
            "trigger_field_true": "pa_has",
            "trigger_field_false": "pa_none",
            "fields": [
              "pa_name", "pa_company", "pa_position", "pa_phone", 
              "pa_auth_general", "pa_auth_special"
            ]
          },
          {
            "id": "group_defendant",
            "title": "3. 被告信息",
            "ui_mode": "dynamic_list",
            "allow_add": true,
            "fields_mapping": {
              "type_selector": {
                "label": "主体类型",
                "options": [
                  {
                    "label": "自然人",
                    "value": "natural",
                    "fields": [
                      "d_name", "d_gender_m", "d_gender_f", "d_birth_y", "d_birth_m", "d_birth_d", 
                      "d_ethnic", "d_company", "d_position", "d_phone", "d_reg_addr", "d_res_addr", 
                      "d_id_type", "d_id_num"
                    ]
                  },
                  {
                    "label": "法人/非法人组织",
                    "value": "legal",
                    "fields": [
                      "dc_name", "dc_addr", "dc_reg_addr", "dc_legal_rep", "dc_position", "dc_phone", "dc_credit_code"
                    ],
                    "sub_groups": [
                      {
                        "label": "单位类型 (单选)",
                        "ui_mode": "radio_group_boolean",
                        "fields": [
                          "dc_type_llc", "dc_type_jsc", "dc_type_listed", "dc_type_other_ent", 
                          "dc_type_inst", "dc_type_org", "dc_type_fund", "dc_type_service", 
                          "dc_type_gov", "dc_type_rural", "dc_type_coop", "dc_type_community", 
                          "dc_type_sole", "dc_type_partner", "dc_type_prof"
                        ]
                      },
                      {
                        "label": "所有制性质 (单选)",
                        "ui_mode": "radio_group_boolean",
                        "fields": [
                          "dc_own_state", "dc_own_state_ctrl", "dc_own_state_share", "dc_own_private", "dc_own_other"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "id": "group_third_party",
            "title": "4. 第三人信息",
            "ui_mode": "dynamic_list",
            "allow_add": true,
            "fields_mapping": {
              "type_selector": {
                "label": "主体类型",
                "options": [
                  {
                    "label": "自然人",
                    "value": "natural",
                    "fields": [
                      "t_name", "t_gender_m", "t_gender_f", "t_birth_y", "t_birth_m", "t_birth_d", 
                      "t_ethnic", "t_company", "t_position", "t_phone", "t_reg_addr", "t_res_addr", 
                      "t_id_type", "t_id_num"
                    ]
                  },
                  {
                    "label": "法人/非法人组织",
                    "value": "legal",
                    "fields": [
                      "tc_name", "tc_addr", "tc_reg_addr", "tc_legal_rep", "tc_position", "tc_phone", "tc_credit_code"
                    ],
                    "sub_groups": [
                      {
                        "label": "单位类型 (单选)",
                        "ui_mode": "radio_group_boolean",
                        "fields": [
                          "tc_type_llc", "tc_type_jsc", "tc_type_listed", "tc_type_other_ent", 
                          "tc_type_inst", "tc_type_org", "tc_type_fund", "tc_type_service", 
                          "tc_type_gov", "tc_type_rural", "tc_type_coop", "tc_type_community", 
                          "tc_type_sole", "tc_type_partner", "tc_type_prof"
                        ]
                      },
                      {
                        "label": "所有制性质 (单选)",
                        "ui_mode": "radio_group_boolean",
                        "fields": [
                          "tc_own_state", "tc_own_state_ctrl", "tc_own_state_share", "tc_own_private", "tc_own_other"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "id": "section_claims",
        "title": "二、诉讼请求",
        "description": "请填写诉讼请求详情",
        "groups": [
          {
            "id": "claim_summary",
            "title": "诉讼请求总述",
            "description": "请在此处概括您的核心诉求（对应文档开头的 {claim_content}）",
            "ui_mode": "textarea_full_width",
            "fields": ["claim_content"] 
          },
          {
            "id": "claim_1_contract",
            "title": "1. 房屋买卖合同关系",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "contract_has_issue",
            "trigger_field_false": "contract_no_issue",
            "detail_fields": [
              "contract_claim_invalid", "contract_claim_not_formed", "contract_claim_terminate", 
              "contract_claim_revoke", "contract_claim_continue", "contract_claim_formal", 
              "contract_claim_detail"
            ]
          },
          {
            "id": "claim_2_payment",
            "title": "2. 支付或返还购房款",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "payment_has_issue",
            "trigger_field_false": "payment_no_issue",
            "detail_fields": [
              "payment_return_down", "payment_return_deposit", "payment_return_paid", 
              "payment_pay_owed", "payment_penalty", "payment_interest", "payment_compensation", 
              "payment_amount_detail"
            ]
          },
          {
            "id": "claim_3_delivery",
            "title": "3. 交付或返还房屋",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "delivery_has_issue",
            "trigger_field_false": "delivery_no_issue",
            "detail_fields": [
              "delivery_claim_yes", "delivery_claim_no", 
              "return_claim_yes", "return_claim_no", 
              "delay_penalty_yes", "delay_penalty_no"
            ]
          },
          {
            "id": "claim_4_registration",
            "title": "4. 办理房屋登记手续",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "registration_has_issue",
            "trigger_field_false": "registration_no_issue",
            "detail_fields": [
              "registration_assist_yes", "registration_assist_no", 
              "registration_penalty_yes", "registration_penalty_no"
            ]
          },
          {
            "id": "claim_5_agency",
            "title": "5. 返还或承担中介服务费",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "agency_fee_has_issue",
            "trigger_field_false": "agency_fee_no_issue",
            "detail_fields": [
              "agency_fee_return_yes", "agency_fee_return_no", 
              "agency_fee_bear_yes", "agency_fee_bear_no", 
              "agency_fee_amount_detail"
            ]
          },
          {
            "id": "claim_6_quality",
            "title": "6. 房屋质量损害赔偿",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "quality_has_issue",
            "trigger_field_false": "quality_no_issue",
            "detail_fields": [
              "quality_repair_yes", "quality_repair_no", 
              "quality_cost_yes", "quality_cost_no", 
              "quality_amount_detail"
            ]
          },
          {
            "id": "claim_7_mortgage",
            "title": "7. 解除担保贷款（按揭）合同",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "mortgage_has_issue",
            "trigger_field_false": "mortgage_no_issue",
            "detail_fields": [
              "mortgage_requirement"
            ]
          },
          {
            "id": "claim_8_appraisal",
            "title": "8. 鉴定及其他实现债权的费用",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "appraisal_has_issue",
            "trigger_field_false": "appraisal_no_issue",
            "detail_fields": [
              "appraisal_request_yes", "appraisal_request_no", "appraisal_cost_detail"
            ]
          },
          {
            "id": "claim_others",
            "title": "9. 诉讼费及其他请求",
            "ui_mode": "static_section",
            "fields": [
              "litigation_cost_yes", "litigation_cost_no", 
              "other_request", "total_amount"
            ]
          }
        ]
      },
      {
        "id": "section_jurisdiction",
        "title": "三、约定管辖和诉前保全",
        "groups": [
          {
            "id": "jurisdiction_info",
            "title": "3.1 仲裁或法院管辖约定",
            "ui_mode": "radio_group_boolean",
            "fields": [
              "jurisdiction_has", "jurisdiction_none"
            ],
            "detail_fields": ["jurisdiction_content"]
          },
          {
            "id": "preservation_info",
            "title": "3.2 诉前财产保全情况",
            "ui_mode": "radio_group_boolean",
            "fields": [
              "preservation_yes", "preservation_no"
            ],
            "detail_fields": [
              "preservation_court", "preservation_time", "preservation_case_no"
            ]
          }
        ]
      },
      {
        "id": "section_facts",
        "title": "四、事实与理由",
        "description": "请根据以下要素完善案件详情",
        "groups": [
          {
            "id": "facts_summary",
            "title": "事实与理由概述",
            "fields": ["facts_and_reasons"]
          },
          {
            "id": "fact_element_1",
            "title": "要素一：合同基本情况",
            "fields": [
              "contract_date", 
              "house_location", "house_area", "house_unit_price", "house_total_price"
            ],
            "sub_groups": [
              {
                "label": "房屋性质",
                "fields": ["house_type_commercial", "house_type_affordable", "house_type_self_built", "house_type_other"]
              },
              {
                "label": "销售属性",
                "fields": ["house_first_sale_yes", "house_first_sale_no", "house_presale_yes", "house_presale_no"]
              },
              {
                "label": "登记备案情况",
                "fields": ["presale_registered_yes", "presale_registered_no", "online_signed_yes", "online_signed_no", "advance_registered_yes", "advance_registered_no"]
              },
              {
                "label": "合同性质与解除",
                "fields": ["contract_nature_formal", "contract_nature_preliminary", "termination_notice_yes", "termination_notice_no", "termination_reason"]
              }
            ]
          },
          {
            "id": "fact_element_2",
            "title": "要素二：购房款支付情况",
            "fields": [
              "payment_amount", "deposit_amount", "payment_agreement", "payment_other_reason"
            ],
            "sub_groups": [
              {
                "label": "支付方式",
                "fields": ["payment_method_mortgage", "payment_method_cash", "payment_method_house", "payment_method_other"]
              },
              {
                "label": "定金与装修",
                "fields": ["deposit_paid_yes", "deposit_paid_no", "decoration_yes", "decoration_no"]
              }
            ]
          },
          {
            "id": "fact_element_3",
            "title": "要素三：房屋交付情况",
            "fields": ["delivery_agreed_time"],
            "sub_groups": [
              {
                "label": "交付状态",
                "fields": ["delivery_actual_yes", "delivery_actual_no", "area_diff_yes", "area_diff_no", "parking_yes", "parking_no"]
              }
            ]
          },
          {
            "id": "fact_element_4",
            "title": "要素四：登记办证情况",
            "fields": ["overdue_cert_penalty", "penalty_calculation"],
            "sub_groups": [
              {
                "label": "登记状态",
                "fields": ["first_registration_yes", "first_registration_no", "transfer_registration_yes", "transfer_registration_no"]
              }
            ]
          },
          {
            "id": "fact_element_5",
            "title": "要素五：中介与质量",
            "fields": [
              "agency_fee_reason", "compensation_amount"
            ],
            "sub_groups": [
              {
                "label": "中介费承担",
                "fields": ["agency_fee_return", "agency_fee_bear"]
              },
              {
                "label": "质量问题性质",
                "fields": ["quality_serious", "quality_repairable"]
              },
              {
                "label": "维修情况",
                "fields": ["warranty_yes", "warranty_no", "repair_action_yes", "repair_action_no", "repair_notice_yes", "repair_notice_no"]
              }
            ]
          },
          {
            "id": "fact_element_6",
            "title": "要素六：按揭与鉴定",
            "sub_groups": [
              {
                "label": "担保贷款合同",
                "fields": ["mortgage_contract_yes", "mortgage_contract_no", "mortgage_contract_detail"]
              },
              {
                "label": "鉴定申请",
                "fields": ["appraisal_fact_yes", "appraisal_fact_no", "appraisal_fact_detail"]
              }
            ]
          },
          {
            "id": "fact_legal_basis",
            "title": "请求依据与证据",
            "fields": ["legal_basis_contract", "legal_basis_law", "evidence_list"]
          }
        ]
      },
      {
        "id": "section_mediation",
        "title": "五、纠纷解决方式意愿",
        "ui_mode": "accordion_questionnaire",
        "groups": [
          {
            "id": "mediation_q1",
            "title": "是否了解调解的非诉性质",
            "fields": ["mediation_understand", "mediation_not_understand"]
          },
          {
            "id": "mediation_q2",
            "title": "是否了解先行调解的好处",
            "type": "checklist_confirmation",
            "sub_items": [
              { "text": "快速启动程序", "fields": ["mediation_benefit1_understand", "mediation_benefit1_not_understand"] },
              { "text": "费用减免政策", "fields": ["mediation_benefit2_understand", "mediation_benefit2_not_understand"] },
              { "text": "灵活更换调解员", "fields": ["mediation_benefit3_understand", "mediation_benefit3_not_understand"] },
              { "text": "保密性保障", "fields": ["mediation_benefit4_understand", "mediation_benefit4_not_understand"] },
              { "text": "司法确认效力", "fields": ["mediation_benefit5_understand", "mediation_benefit5_not_understand"] }
            ]
          },
          {
            "id": "mediation_decision",
            "title": "是否考虑先行调解",
            "fields": ["consider_mediation_yes", "consider_mediation_no", "consider_mediation_uncertain"]
          }
        ]
      }
    ]
  }
}
