      {
        "id": "section_claims",
        "title": "二、诉讼请求",
        "description": "请填写诉讼请求详情",
        "groups": [
          {
            "id": "claim_summary",
            "title": "诉讼请求总述",
            "description": "请在此处概括您的核心诉求（对应文档开头的 {claim_content}）",
            "ui_mode": "textarea_full_width",
            "fields": ["claim_content"]
          },
          {
            "id": "claim_1_contract",
            "title": "1. 房屋买卖合同关系",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "contract_has_issue",
            "trigger_field_false": "contract_no_issue",
            "detail_fields": [
              "contract_claim_invalid",
              "contract_claim_not_formed",
              "contract_claim_terminate",
              "contract_claim_revoke",
              "contract_claim_continue",
              "contract_claim_formal",
              "contract_claim_detail"
            ]
          },
          {
            "id": "claim_2_payment",
            "title": "2. 支付或返还购房款",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "payment_has_issue",
            "trigger_field_false": "payment_no_issue",
            "detail_fields": [
              "payment_return_down",
              "payment_return_deposit",
              "payment_return_paid",
              "payment_pay_owed",
              "payment_penalty",
              "payment_interest",
              "payment_compensation",
              "payment_amount_detail"
            ]
          },
          {
            "id": "claim_3_delivery",
            "title": "3. 交付或返还房屋",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "delivery_has_issue",
            "trigger_field_false": "delivery_no_issue",
            "detail_fields": [
              "delivery_claim_yes",
              "delivery_claim_no",
              "return_claim_yes",
              "return_claim_no",
              "delay_penalty_yes",
              "delay_penalty_no"
            ]
          },
          {
            "id": "claim_4_registration",
            "title": "4. 办理房屋登记手续",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "registration_has_issue",
            "trigger_field_false": "registration_no_issue",
            "detail_fields": [
              "registration_assist_yes",
              "registration_assist_no",
              "registration_penalty_yes",
              "registration_penalty_no"
            ]
          },
          {
            "id": "claim_5_agency",
            "title": "5. 返还或承担中介服务费",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "agency_fee_has_issue",
            "trigger_field_false": "agency_fee_no_issue",
            "detail_fields": [
              "agency_fee_return_yes",
              "agency_fee_return_no",
              "agency_fee_bear_yes",
              "agency_fee_bear_no",
              "agency_fee_amount_detail"
            ]
          },
          {
            "id": "claim_6_quality",
            "title": "6. 房屋质量损害赔偿",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "quality_has_issue",
            "trigger_field_false": "quality_no_issue",
            "detail_fields": [
              "quality_repair_yes",
              "quality_repair_no",
              "quality_cost_yes",
              "quality_cost_no",
              "quality_amount_detail"
            ]
          },
          {
            "id": "claim_7_mortgage",
            "title": "7. 解除担保贷款（按揭）合同",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "mortgage_has_issue",
            "trigger_field_false": "mortgage_no_issue",
            "detail_fields": ["mortgage_requirement"]
          },
          {
            "id": "claim_8_appraisal",
            "title": "8. 鉴定及其他实现债权的费用",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "appraisal_has_issue",
            "trigger_field_false": "appraisal_no_issue",
            "detail_fields": [
              "appraisal_request_yes",
              "appraisal_request_no",
              "appraisal_cost_detail"
            ]
          },
          {
            "id": "claim_litigation_cost",
            "title": "9. 诉讼费及其他请求",
            "ui_mode": "checkbox_activation",
            "trigger_field_true": "litigation_cost_yes",
            "trigger_field_false": "litigation_cost_no",
            "detail_fields": []
          },
          {
            "id": "claim_other_request",
            "title": "10. 其他请求",
            "ui_mode": "simple_fields",
            "fields": ["other_request"]
          },
          {
            "id": "claim_total_amount",
            "title": "11. 标的总额",
            "ui_mode": "simple_fields",
            "fields": ["total_amount"]
          }
        ]
      },
      {
        "id": "section_jurisdiction",
        "title": "三、约定管辖和诉前保全",
        "groups": [
          {
            "id": "jurisdiction_info",
            "title": "3.1 仲裁或法院管辖约定",
            "ui_mode": "radio_group_boolean",
            "fields": ["jurisdiction_has", "jurisdiction_none"],
            "detail_fields": ["jurisdiction_content"]
          },
          {
            "id": "preservation_info",
            "title": "3.2 诉前财产保全情况",
            "ui_mode": "radio_group_boolean",
            "fields": ["preservation_yes", "preservation_no"],
            "detail_fields": [
              "preservation_court",
              "preservation_time",
              "preservation_case_no"
            ]
          }
        ]
      },
      {
        "id": "section_facts",
        "title": "四、事实与理由",
        "description": "请根据以下要素完善案件详情",
        "groups": [
          {
            "id": "facts_summary",
            "title": "事实与理由概述",
            "fields": ["facts_and_reasons"]
          },
          {
            "id": "fact_element_1",
            "title": "要素一：合同基本情况",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "合同订立时间",
                "fields": ["contract_date"]
              },
              {
                "label": "房屋位置",
                "fields": ["house_location"]
              },
              {
                "label": "房屋面积",
                "fields": ["house_area"]
              },
              {
                "label": "房屋单价",
                "fields": ["house_unit_price"]
              },
              {
                "label": "总价",
                "fields": ["house_total_price"]
              },
              {
                "label": "房屋是否首次出售",
                "fields": ["house_first_sale_yes", "house_first_sale_no"]
              },
              {
                "label": "是否为预售房",
                "fields": ["house_presale_yes", "house_presale_no"]
              },
              {
                "label": "是否预售登记",
                "fields": ["presale_registered_yes", "presale_registered_no"]
              },
              {
                "label": "是否网签",
                "fields": ["online_signed_yes", "online_signed_no"]
              },
              {
                "label": "是否预告登记",
                "fields": ["advance_registered_yes", "advance_registered_no"]
              },
              {
                "label": "订立的合同性质",
                "fields": [
                  "contract_nature_formal",
                  "contract_nature_preliminary"
                ]
              },
              {
                "label": "是否已向被告发出解除/撤销通知/催告通知",
                "fields": ["termination_notice_yes", "termination_notice_no"]
              },
              {
                "label": "解除/撤销事由",
                "fields": ["termination_reason"]
              }
            ]
          },
          {
            "id": "fact_element_2",
            "title": "要素二：购房款支付情况",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "支付金额",
                "fields": ["payment_amount"]
              },
              {
                "label": "定金金额",
                "fields": ["deposit_amount"]
              },
              {
                "label": "支付方式",
                "ui_mode": "single_choice",
                "fields": [
                  "payment_method_mortgage",
                  "payment_method_cash",
                  "payment_method_house",
                  "payment_method_other"
                ]
              },
              {
                "label": "是否已支付定金",
                "fields": ["deposit_paid_yes", "deposit_paid_no"]
              },
              {
                "label": "是否已装修",
                "fields": ["decoration_yes", "decoration_no"]
              },
              {
                "label": "支付约定",
                "fields": ["payment_agreement"]
              },
              {
                "label": "其他支付原因",
                "fields": ["payment_other_reason"]
              }
            ]
          },
          {
            "id": "fact_element_3",
            "title": "要素三：房屋交付情况",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "约定交付时间",
                "fields": ["delivery_agreed_time"]
              },
              {
                "label": "是否实际交付",
                "fields": ["delivery_actual_yes", "delivery_actual_no"]
              },
              {
                "label": "是否存在面积差异",
                "fields": ["area_diff_yes", "area_diff_no"]
              },
              {
                "label": "是否包含车位",
                "fields": ["parking_yes", "parking_no"]
              }
            ]
          },
          {
            "id": "fact_element_4",
            "title": "要素四：登记办证情况",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "是否首次登记",
                "fields": ["first_registration_yes", "first_registration_no"]
              },
              {
                "label": "是否转移登记",
                "fields": [
                  "transfer_registration_yes",
                  "transfer_registration_no"
                ]
              },
              {
                "label": "逾期办证违约金",
                "fields": ["overdue_cert_penalty"]
              },
              {
                "label": "违约金计算方式",
                "fields": ["penalty_calculation"]
              }
            ]
          },
          {
            "id": "fact_element_5",
            "title": "5. 中介服务费情况",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "",
                "ui_mode": "single_choice",
                "fields": ["agency_fee_return", "agency_fee_bear"]
              },
              {
                "label": "中介服务费的事由",
                "fields": ["agency_fee_reason"]
              }
            ]
          },
          {
            "id": "fact_element_6",
            "title": "6. 质量损害赔偿相关情况",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "属于严重影响正常居住使用的质量问题",
                "fields": ["quality_serious"]
              },
              {
                "label": "属于可修复的质量问题",
                "fields": ["quality_repairable"]
              },
              {
                "label": "是否还在质保期内",
                "fields": ["warranty_yes", "warranty_no"]
              },
              {
                "label": "是否存在修复行为",
                "fields": ["repair_action_yes", "repair_action_no"]
              },
              {
                "label": "是否通知维修",
                "fields": ["repair_notice_yes", "repair_notice_no"]
              },
              {
                "label": "赔偿数额",
                "fields": ["compensation_amount"]
              }
            ]
          },
          {
            "id": "fact_element_7",
            "title": "7. 是否签订担保贷款（按揭）合同",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "",
                "ui_mode": "yes_no_with_detail",
                "fields": [
                  "mortgage_contract_yes",
                  "mortgage_contract_no",
                  "mortgage_contract_detail"
                ]
              }
            ]
          },
          {
            "id": "fact_element_8",
            "title": "8. 申请鉴定及其他实现债权费用的事实",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "",
                "ui_mode": "yes_no_with_detail",
                "fields": [
                  "appraisal_fact_yes",
                  "appraisal_fact_no",
                  "appraisal_fact_detail"
                ]
              }
            ]
          },
          {
            "id": "fact_legal_basis",
            "title": "9. 请求依据",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "合同约定",
                "fields": ["legal_basis_contract"]
              },
              {
                "label": "法律规定",
                "fields": ["legal_basis_law"]
              }
            ]
          },
          {
            "id": "fact_evidence",
            "title": "10. 证据清单（可另附页）",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "",
                "fields": ["evidence_list"]
              }
            ]
          }
        ]
      },
      {
        "id": "section_mediation",
        "title": "五、纠纷解决方式意愿",
        "description": "",
        "groups": [
          {
            "id": "mediation_q1",
            "title": "是否了解调解的非诉性质",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "",
                "ui_mode": "single_choice",
                "fields": ["mediation_understand", "mediation_not_understand"]
              }
            ]
          },
          {
            "id": "mediation_q2",
            "title": "是否了解先行调解的好处",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "快速启动程序",
                "fields": ["mediation_benefit1_understand", "mediation_benefit1_not_understand"]
              },
              {
                "label": "费用减免政策",
                "fields": ["mediation_benefit2_understand", "mediation_benefit2_not_understand"]
              },
              {
                "label": "灵活更换调解员",
                "fields": ["mediation_benefit3_understand", "mediation_benefit3_not_understand"]
              },
              {
                "label": "保密性保障",
