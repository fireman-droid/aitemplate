              }
            ]
          },
          {
            "id": "mediation_decision",
            "title": "是否考虑先行调解",
            "ui_mode": "structured_form",
            "sections": [
              {
                "label": "",
                "ui_mode": "single_choice",
                "fields": ["consider_mediation_yes", "consider_mediation_no", "consider_mediation_uncertain"]
              }
            ]
          }
        ]
      }
    ]
  }
