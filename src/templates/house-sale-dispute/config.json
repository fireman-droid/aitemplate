{
  "lawsuit_template": {
    "name": "民事起诉状模板（房屋买卖合同纠纷）",
    "groups": [
      {
        "id": "party_info",
        "title": "一、当事人信息",
        "icon": "User",
        "defaultExpanded": true,
        "subgroups": [
          {
            "id": "plaintiff_info",
            "title": "1.1 原告信息",
            "type": "section",
            "subgroups": [
              {
                "id": "plaintiff_person",
                "title": "□ 原告为自然人",
                "description": "包含：姓名、性别、出生日期、民族、工作单位、职务、联系电话、住所地、经常居住地、证件类型、证件号码等字段",
                "prefix": "p_",
                "excludePrefixes": ["pc_", "pa_"]
              },
              {
                "id": "plaintiff_company",
                "title": "□ 原告为法人/非法人组织",
                "description": "包含：名称、住所地、注册地、法定代表人、联系电话、统一社会信用代码、类型、所有制性质等字段",
                "prefix": "pc_"
              }
            ]
          },
          {
            "id": "plaintiff_agent",
            "title": "1.2 委托诉讼代理人信息",
            "description": "如有代理人，则填写：姓名、单位、职务、联系电话、代理权限等字段",
            "prefix": "pa_"
          },
          {
            "id": "defendant_info",
            "title": "1.3 被告信息",
            "type": "section",
            "subgroups": [
              {
                "id": "defendant_person",
                "title": "□ 被告为自然人",
                "description": "字段同原告为自然人",
                "prefix": "d_",
                "excludePrefixes": ["dc_"]
              },
              {
                "id": "defendant_company",
                "title": "□ 被告为法人/非法人组织",
                "description": "字段同原告为法人/非法人组织",
                "prefix": "dc_"
              }
            ]
          },
          {
            "id": "third_party_info",
            "title": "1.4 第三人信息",
            "description": "如有第三人，则填写以下子项",
            "type": "section",
            "subgroups": [
              {
                "id": "third_party_person",
                "title": "□ 第三人为自然人",
                "description": "字段同原告为自然人",
                "prefix": "t_",
                "excludePrefixes": ["tc_"]
              },
              {
                "id": "third_party_company",
                "title": "□ 第三人为法人/非法人组织",
                "description": "字段同原告为法人/非法人组织",
                "prefix": "tc_"
              }
            ]
          }
        ]
      },
      {
        "id": "claims",
        "title": "二、诉讼请求",
        "icon": "Document",
        "defaultExpanded": true,
        "subgroups": [
          {
            "id": "total_amount",
            "title": "2.1 标的总额",
            "description": "填写本次诉讼的总金额",
            "fields": ["total_amount"]
          },
          {
            "id": "specific_requests",
            "title": "2.2 各项具体请求",
            "type": "section",
            "subgroups": [
              {
                "id": "contract_request",
                "title": "请求一：关于房屋买卖合同关系",
                "description": "确认合同无效/未成立/解除/撤销/继续履行等",
                "prefixPattern": "contract_"
              },
              {
                "id": "payment_request",
                "title": "请求二：关于支付或返还购房款",
                "description": "返还首付款/定金/已付款，或主张支付欠付房款/违约金/利息等",
                "prefixPattern": "payment_"
              },
              {
                "id": "delivery_request",
                "title": "请求三：关于交付或返还房屋",
                "description": "主张交付房屋、返还房屋、支付逾期交房违约金",
                "prefixPattern": "delivery_|return_|delay_"
              },
              {
                "id": "registration_request",
                "title": "请求四：关于办理房屋登记手续",
                "description": "主张协助办证、支付逾期办证违约金",
                "prefixPattern": "registration_"
              },
              {
                "id": "agency_fee_request",
                "title": "请求五：关于返还或承担中介服务费",
                "description": "主张返还或由被告承担，并填写金额明细",
                "prefixPattern": "agency_fee_"
              },
              {
                "id": "quality_request",
                "title": "请求六：关于房屋质量损害赔偿",
                "description": "主张维修、承担维修费，并填写金额明细",
                "prefixPattern": "quality_"
              },
              {
                "id": "mortgage_request",
                "title": "请求七：关于解除担保贷款（按揭）合同",
                "description": "填写具体要求",
                "prefixPattern": "mortgage_"
              },
              {
                "id": "appraisal_request",
                "title": "请求八：关于鉴定及其他实现债权的费用",
                "description": "请求委托鉴定，并填写费用明细",
                "prefixPattern": "appraisal_"
              },
              {
                "id": "litigation_cost",
                "title": "请求九：关于诉讼费用承担",
                "fields": ["litigation_cost_yes", "litigation_cost_no"]
              },
              {
                "id": "other_request",
                "title": "请求十：其他请求",
                "description": "填写未在上述列明的其他诉讼请求",
                "fields": ["other_request"]
              }
            ]
          }
        ]
      },
      {
        "id": "jurisdiction_preservation",
        "title": "三、约定管辖和诉前保全",
        "icon": "Document",
        "defaultExpanded": true,
        "subgroups": [
          {
            "id": "jurisdiction",
            "title": "3.1 仲裁或法院管辖约定",
            "description": "如有约定，填写合同条款内容",
            "prefixPattern": "jurisdiction_"
          },
          {
            "id": "preservation",
            "title": "3.2 诉前财产保全情况",
            "description": "如已保全，填写保全法院、保全时间、保全案号",
            "prefixPattern": "preservation_"
          }
        ]
      },
      {
        "id": "facts_reasons",
        "title": "四、事实与理由",
        "icon": "Document",
        "defaultExpanded": true,
        "subgroups": [
          {
            "id": "facts_detail",
            "title": "4.1 事实与理由详述",
            "description": "完整陈述纠纷的经过、原因和理由",
            "fields": ["facts_and_reasons"]
          },
          {
            "id": "key_facts",
            "title": "4.2 关键事实要素",
            "type": "section",
            "subgroups": [
              {
                "id": "contract_basic",
                "title": "要素一：合同基本情况",
                "description": "合同订立时间、房屋性质、位置、面积、价格、是否预售、是否网签、合同性质等",
                "fields": ["contract_date", "house_type_commercial", "house_type_affordable", "house_type_self_built", "house_type_other", "house_location", "house_area", "house_unit_price", "house_total_price", "house_first_sale_yes", "house_first_sale_no", "house_presale_yes", "house_presale_no", "online_signed_yes", "online_signed_no", "contract_nature_formal", "contract_nature_preliminary"]
              },
              {
                "id": "payment_situation",
                "title": "要素二：购房款支付情况",
                "description": "支付方式、已付/欠付金额、定金情况、合同约定等",
                "fields": ["payment_method_mortgage", "payment_method_cash", "payment_method_house", "payment_method_other", "payment_amount", "deposit_paid_yes", "deposit_amount", "deposit_paid_no", "payment_agreement", "payment_other_reason"]
              },
              {
                "id": "delivery_situation",
                "title": "要素三：房屋交付情况",
                "description": "是否实际交付、是否存在面积差、合同约定交房时间等",
                "fields": ["delivery_actual_yes", "delivery_actual_no", "area_diff_yes", "area_diff_no", "parking_yes", "parking_no", "delivery_agreed_time"]
              },
              {
                "id": "registration_situation",
                "title": "要素四：房屋登记手续办理情况",
                "description": "是否取得首次登记、是否办理转移登记、违约金约定等",
                "fields": ["first_registration_yes", "first_registration_no", "transfer_registration_yes", "transfer_registration_no", "overdue_cert_penalty", "penalty_calculation"]
              },
              {
                "id": "agency_fee_reason",
                "title": "要素五：中介服务费相关事由",
                "description": "填写要求返还或承担中介费的原因",
                "fields": ["agency_fee_return", "agency_fee_bear", "agency_fee_reason"]
              },
              {
                "id": "quality_description",
                "title": "要素六：房屋质量问题描述",
                "description": "质量问题类型、是否在质保期、是否通知维修等",
                "fields": ["quality_serious", "quality_repairable", "warranty_yes", "warranty_no", "repair_action_yes", "repair_action_no", "repair_notice_yes", "repair_notice_no", "compensation_amount"]
              },
              {
                "id": "mortgage_situation",
                "title": "要素七：担保贷款（按揭）合同情况",
                "description": "是否已签订，如已签订填写具体情况",
                "fields": ["mortgage_contract_yes", "mortgage_contract_detail", "mortgage_contract_no"]
              },
              {
                "id": "appraisal_facts",
                "title": "要素八：申请鉴定的事实",
                "description": "描述需要鉴定的原因和具体情况",
                "fields": ["appraisal_fact_yes", "appraisal_fact_detail", "appraisal_fact_no"]
              },
              {
                "id": "legal_basis",
                "title": "要素九：请求的法律与合同依据",
                "description": "填写所依据的合同条款和法律条文",
                "fields": ["legal_basis_contract", "legal_basis_law"]
              }
            ]
          },
          {
            "id": "evidence_list",
            "title": "4.3 证据清单",
            "description": "列出所有证据材料的名称清单，可另附页",
            "fields": ["evidence_list"]
          }
        ]
      },
      {
        "id": "mediation_willingness",
        "title": "五、纠纷解决方式意愿",
        "icon": "ChatDotRound",
        "defaultExpanded": false,
        "subgroups": [
          {
            "id": "mediation_knowledge",
            "title": "5.1 对调解的认知",
            "description": "确认是否知悉调解程序的好处（快速启动、费用减免、保密性等）",
            "fields": ["mediation_understand", "mediation_not_understand", "mediation_benefit1_understand", "mediation_benefit1_not_understand", "mediation_benefit2_understand", "mediation_benefit2_not_understand", "mediation_benefit3_understand", "mediation_benefit3_not_understand", "mediation_benefit4_understand", "mediation_benefit4_not_understand", "mediation_benefit5_understand", "mediation_benefit5_not_understand"]
          },
          {
            "id": "mediation_consideration",
            "title": "5.2 是否考虑先行调解",
            "fields": ["consider_mediation_yes", "consider_mediation_no", "consider_mediation_uncertain"]
          }
        ]
      },
      {
        "id": "signature",
        "title": "六、具状人签署",
        "icon": "Edit",
        "defaultExpanded": false,
        "subgroups": [
          {
            "id": "signature_info",
            "title": "签署信息",
            "description": "具状人签字/盖章及日期",
            "fields": ["claim_content"]
          }
        ]
      }
    ]
  }
}
